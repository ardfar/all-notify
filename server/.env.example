# Copy to .env on your VPS (never commit .env or K_master!)

# Required only when using `--profile tls` (Caddy automatic Let's Encrypt HTTPS/WSS)
ALLNOTIFY_DOMAIN=notify.example.com

# Bind address on host when using an existing reverse proxy (Option A)
ALLNOTIFY_BIND_ADDR=127.0.0.1:8080

# Retention & payload limits (defaults match docs/SERVER.md)
ALLNOTIFY_TTL_HOURS=24
ALLNOTIFY_MAX_EVENT_BYTES=65536
ALLNOTIFY_MAX_BLOB_BYTES=563200
ALLNOTIFY_MAX_TOTAL_BLOB_MB=256
